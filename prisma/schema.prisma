// Prisma 7 schema. Connection URL lives in prisma.config.ts (not here).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  role      String    @default("ADMIN")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  artworks  Artwork[]
}

model Artwork {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String
  imageWidth  Int?
  imageHeight Int?
  medium      String?
  dimensions  String?
  year        Int?
  category    String   @default("Paintings")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([featured, createdAt])
}
