POOLED_DATABASE_URL=""
DATABASE_URL="postgresql://art:art@localhost:5433/art_showcase?schema=public"

# Required in every environment. Generate with: npx auth secret
AUTH_SECRET=""

# Vercel Blob. Locally these point at the Blob emulator started by
# `pnpm db:up` (docker compose); the token just has to match the one in
# docker-compose.yml. In production, connect a Blob store on Vercel (it sets
# BLOB_READ_WRITE_TOKEN) and leave both *_VERCEL_BLOB_API_URL vars unset.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_emulator_local"
VERCEL_BLOB_API_URL="http://localhost:3100/api/blob"
NEXT_PUBLIC_VERCEL_BLOB_API_URL="http://localhost:3100/api/blob"