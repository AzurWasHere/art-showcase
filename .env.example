# ?? Database ???????????????????????????????????????????????????????????????
# Local: `pnpm db:up` starts Postgres 17 in Docker on host port 5433
# (override with DB_PORT in this file if 5433 is taken).
# Production: paste the connection string from your Vercel/Prisma Postgres store.
DATABASE_URL="postgresql://art:art@localhost:5433/art_showcase?schema=public"
# DB_PORT=5433

# ?? Auth.js ????????????????????????????????????????????????????????????????
# Required in every environment. Generate with: npx auth secret
AUTH_SECRET=""

# ?? Curator (admin) credentials ????????????????????????????????????????????
# Used by `pnpm db:seed` to create/update the admin user. The login form also
# accepts these directly as a fallback, so you can sign in before seeding.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# ?? Image storage ??????????????????????????????????????????????????????????
# Vercel Blob read/write token. Leave empty in development to store uploads
# under public/uploads/ instead. Required in production.
BLOB_READ_WRITE_TOKEN=""